# 도메인이 있고 HTTPS 를 자동으로 받고 싶을 때 (Caddy 가 Let's Encrypt 인증서를 자동 발급)
#   caddy run --config deploy/Caddyfile
#
# onference.example.com 을 실제 도메인으로 바꾸고, 서버의 80/443 포트를 열어 두면 된다.

onference.example.com {
    root * /srv/onference
    file_server
    try_files {path} /index.html

    # 내부용 — 접근 제어를 걸려면 아래 블록 주석을 해제하고
    # caddy hash-password 로 만든 해시를 넣는다.
    # basic_auth {
    #     staff $2a$14$...해시...
    # }

    encode gzip
    header /assets/* Cache-Control "public, max-age=31536000, immutable"
    header Cache-Control "no-cache"
    header X-Content-Type-Options "nosniff"
}
